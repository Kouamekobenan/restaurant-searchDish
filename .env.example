# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# JWT
JWT_SECRET=
JWT_EXPIRES_IN="7d"

# Google Maps (optionnel)
GOOGLE_MAPS_API_KEY=

# Environment
NODE_ENV="development"
PORT=3001
HOST=0.0.0.0

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin SDK
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com
FIREBASE_DATABASE_URL=

# Jèko (paiement) — clés obtenues sur https://business.jeko.africa/ (Paramètres > API & Webhooks)
JEKO_BASE_URL=https://api.jeko.africa
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_STORE_ID=
JEKO_WEBHOOK_SECRET=
JEKO_SUCCESS_URL=https://example.com/payment/success
JEKO_ERROR_URL=https://example.com/payment/error
